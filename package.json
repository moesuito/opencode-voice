{
  "name": "opencode-voice",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Voz local (Parakeet v3 / NVIDIA) para o OpenCode V2 TUI: grava no microfone, transcreve com parakeet.cpp (Vulkan) e envia o texto como prompt.",
  "engines": {
    "opencode": ">=2.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.23",
    "@opentui/solid": "0.5.14",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode/client": "2.0.23",
    "@opentui/core": "0.5.14",
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  }
}
